{
  "name": "excali",
  "private": true,
  "version": "1.6.4",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "page:dev": "pnpm --filter ./packages/excali-page dev",
    "page:build": "BUILD_FOR_EXTENSION=1 pnpm --filter ./packages/excali-page build",
    "page:test": "pnpm --filter ./packages/excali-page test",
    "local:clean": "tsx scripts/clean.ts",
    "local:build": "tsx scripts/build.ts",
    "local:tar": "tsx scripts/tar.ts",
    "local:zip": "tsx scripts/zip.ts",
    "skill:pack": "tsx scripts/skill-pack.ts",
    "skill:check": "tsx scripts/check-skill-commands.ts",
    "sync:version": "bash ./scripts/sync-version.sh",
    "bridge:build": "cd packages/excali-bridge && go build -buildvcs=false -o bin/excali-bridge .",
    "bridge:test": "cd packages/excali-bridge && go test ./..."
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "clsx": "^2.1.1",
    "excali-shared": "workspace:*",
    "tailwind-merge": "^2.5.3",
    "tsx": "^4.19.0"
  }
}
