{
  "name": "excali",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "page:dev": "pnpm --filter ./packages/page dev",
    "page:build": "BUILD_FOR_EXTENSION=1 pnpm --filter ./packages/page build",
    "local:dev": "pnpm --filter ./packages/local dev",
    "page:test": "pnpm --filter ./packages/page test",
    "collab:test": "pnpm --filter ./packages/collab-core test && pnpm --filter ./packages/collab-relay test",
    "local:clean": "tsx scripts/clean.ts",
    "local:build": "tsx scripts/build.ts",
    "local:tar": "tsx scripts/tar.ts",
    "local:zip": "tsx scripts/zip.ts",
    "typecheck:shared": "pnpm --filter ./packages/shared typecheck",
    "typecheck:page": "pnpm --filter ./packages/page exec tsc -p tsconfig.json --noEmit",
    "typecheck:local": "pnpm --filter ./packages/local exec tsc -p tsconfig.json --noEmit",
    "typecheck:collab": "pnpm --filter ./packages/collab-core typecheck && pnpm --filter ./packages/collab-relay typecheck",
    "typecheck": "pnpm typecheck:shared && pnpm typecheck:page && pnpm typecheck:local && pnpm typecheck:collab",
    "skill:pack": "tsx scripts/skill-pack.ts",
    "skill:check": "tsx scripts/check-skill-commands.ts",
    "sync:version": "bash ./scripts/sync-version.sh",
    "bridge:build": "cd packages/bridge && go build -buildvcs=false -o bin/excali-bridge .",
    "bridge:test": "cd packages/bridge && go test ./...",
    "relay:dev": "tsx scripts/relay-dev.ts",
    "relay:dev:https": "tsx scripts/relay-dev.ts --https",
    "relay:integration": "tsx scripts/relay-integration.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "clsx": "^2.1.1",
    "excali-shared": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.8"
  }
}
